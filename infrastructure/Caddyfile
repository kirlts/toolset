# Toolset Personal — Caddy reverse proxy

{
    http_port 8080
    auto_https off
    admin off
    servers {
        timeouts {
            idle 0
        }
    }
}

# Todas las rutas viven en un snippet para poder servirlas por dos puertos: el 8080 de
# siempre (HTTP plano, lo que ya usan el healthcheck del contenedor y el tailnet interno)
# y el 8091 (HTTPS, Caddy termina la TLS con el certificado de Tailscale — ver mas abajo
# por que existe este segundo puerto).
(rutas_principales) {

    # Health endpoint — lo servía un servicio retirado el 2026-08-19.
    # No se borra: es lo que interroga el healthcheck del propio contenedor
    # (docker-compose: wget http://localhost:8080/health). Sin esto Caddy
    # quedaría marcado unhealthy para siempre.
    handle /health {
        respond "ok" 200
    }

    # kb-mcp — MCP de solo lectura sobre las KB de kb-template.
    # Cada KB se referencia por el nombre de su repositorio: /kb/<repo>/mcp
    # (p.ej. /kb/traza-ambiental/mcp, /kb/personal/mcp). Rutas predecibles a
    # proposito. La autorizacion —quien puede consultar cada KB— es una capa de
    # tokens que se agrega despues; no se mezcla con el enrutamiento.
    # El servidor no expone ninguna herramienta de escritura.
    # Canonicalizacion del slash final. `handle_path` despoja el prefijo /kb antes de
    # pasar la peticion, asi que el backend ignora que existe: cualquier redirect que
    # genere sale sin /kb y en http (p.ej. /kb/<slug>/mcp/ -> http://host/<slug>/mcp),
    # una URL rota. Importa porque hay clientes MCP que documentan la ruta CON slash
    # final —ChatGPT entre ellos—. Se resuelve antes de entrar al handler: `redir` se
    # evalua antes que `handle` en el orden de directivas de Caddy, y el destino
    # relativo conserva el esquema https del cliente.
    @kb_slash path_regexp kbslash ^/kb/(.+)/$
    redir @kb_slash /kb/{re.kbslash.1} 308

    # --- Acceso por direccion-capacidad para la KB okos (UD-004/D5 de kb-okos) ---
    # El secreto viaja EN LA RUTA porque los conectores (claude.ai) solo aceptan una
    # URL, y la respuesta ante ruta desnuda o secreto malo es 404 —nunca 401: un 401
    # dispara en el cliente MCP el descubrimiento OAuth contra /.well-known/*, que
    # aqui responde 404 a proposito, y el cliente falla con un error confuso.
    # Los valores viven en el .env del servidor (via docker-compose), NUNCA en este
    # archivo. Si la variable falta, el matcher queda con un hueco imposible de
    # calzar y la ruta muere: falla CERRADO (la KB inalcanzable, jamas abierta).
    #
    # Acceso total: /kb/<KB_TOKEN_COMPLETO>/okos/mcp — todos los niveles del backend
    # quedan bajo este secreto (incl. /okos-publicado/mcp, para que Martin pueda
    # probar la vista restringida con su propio secreto).
    handle /kb/{$KB_TOKEN_COMPLETO}/* {
        uri strip_prefix /kb/{$KB_TOKEN_COMPLETO}
        reverse_proxy kb-mcp:8765 {
            flush_interval -1
            # SIN keepalive AL BACKEND, A PROPOSITO. El recambio sin caida de kb-mcp
            # (desplegar-sin-caida.sh) saca al contenedor viejo de la red mientras Caddy
            # puede tener una conexion ya abierta y en el pool hacia el (mismo mecanismo
            # con que Compose reparte replicas). Medido el 2026-09-26 en produccion: sin
            # esto, 2 peticiones reales fallaron con "use of closed network connection"
            # justo en el instante del recambio, aunque las conexiones NUEVAS ya resolvian
            # bien al contenedor nuevo — el problema era una conexion vieja reusada, no el
            # mecanismo de alias en si. Sin keepalive cada peticion abre su propia conexion
            # y nunca hereda una hacia un contenedor que ya no esta: el costo es una
            # conexion TCP mas por llamada, sin importancia para el volumen de este backend.
            transport http {
                keepalive off
            }
        }
    }
    # Acceso del fundador — MISMA forma visible que el acceso total: /kb/<secreto>/okos/mcp.
    # El nivel restringido ("publicado") NUNCA debe aparecer en nada que el fundador vea o
    # escriba: revelaria que existe una vista con mas acceso (UD-006, la misma regla de no
    # revelar la jerarquia, aplicada aqui a la URL en vez de al contenido). El secreto por
    # si solo decide el destino: cualquier sufijo que el cliente escriba (o ninguno) se
    # reescribe siempre al mismo backend restringido, sin exponer su nombre interno.
    handle /kb/{$KB_TOKEN_PUBLICADO}/* {
        rewrite * /okos-publicado/mcp
        reverse_proxy kb-mcp:8765 {
            flush_interval -1
            # SIN keepalive AL BACKEND, A PROPOSITO. El recambio sin caida de kb-mcp
            # (desplegar-sin-caida.sh) saca al contenedor viejo de la red mientras Caddy
            # puede tener una conexion ya abierta y en el pool hacia el (mismo mecanismo
            # con que Compose reparte replicas). Medido el 2026-09-26 en produccion: sin
            # esto, 2 peticiones reales fallaron con "use of closed network connection"
            # justo en el instante del recambio, aunque las conexiones NUEVAS ya resolvian
            # bien al contenedor nuevo — el problema era una conexion vieja reusada, no el
            # mecanismo de alias en si. Sin keepalive cada peticion abre su propia conexion
            # y nunca hereda una hacia un contenedor que ya no esta: el costo es una
            # conexion TCP mas por llamada, sin importancia para el volumen de este backend.
            transport http {
                keepalive off
            }
        }
    }
    # Las rutas desnudas de okos dejan de existir hacia afuera.
    handle /kb/okos/* {
        respond 404
    }
    handle /kb/okos-publicado/* {
        respond 404
    }

    handle_path /kb/* {
        reverse_proxy kb-mcp:8765 {
            flush_interval -1
            # SIN keepalive AL BACKEND, A PROPOSITO. El recambio sin caida de kb-mcp
            # (desplegar-sin-caida.sh) saca al contenedor viejo de la red mientras Caddy
            # puede tener una conexion ya abierta y en el pool hacia el (mismo mecanismo
            # con que Compose reparte replicas). Medido el 2026-09-26 en produccion: sin
            # esto, 2 peticiones reales fallaron con "use of closed network connection"
            # justo en el instante del recambio, aunque las conexiones NUEVAS ya resolvian
            # bien al contenedor nuevo — el problema era una conexion vieja reusada, no el
            # mecanismo de alias en si. Sin keepalive cada peticion abre su propia conexion
            # y nunca hereda una hacia un contenedor que ya no esta: el costo es una
            # conexion TCP mas por llamada, sin importancia para el volumen de este backend.
            transport http {
                keepalive off
            }
        }
    }

    # Hermes WebUI — has its own auth
    handle_path /hermes/* {
        reverse_proxy host.docker.internal:8877
    }

    # Infisical API — has its own auth
    handle /api/status {
        reverse_proxy infisical:8080
    }
    handle /api/v1/* {
        reverse_proxy infisical:8080
    }

    # Descubrimiento OAuth (RFC 8414 / RFC 9728) — 404 explicito.
    # Sin esto, el catch-all de abajo responde la landing HTML con HTTP 200 a
    # estas rutas, y un cliente MCP lo lee como "este recurso exige OAuth":
    # arranca el flujo de login, intenta registrarse y falla. El 404 es la
    # respuesta correcta —aqui no hay authorization server— y es lo que hace
    # que el cliente conecte sin autenticacion. Cuando se agregue la capa de
    # tokens por KB, este bloque se reemplaza por la metadata real.
    handle /.well-known/oauth-* {
        respond 404
    }
    handle /.well-known/openid-configuration* {
        respond 404
    }

    # Prototipo visual del mapa OKOS (okos-mapa). Estatico puro: HTML mas dos
    # scripts, sin backend ni datos en vivo. Publico a proposito — es una
    # maqueta para validar la forma del artefacto con quien lo vaya a usar.
    # Sin `try_files`: aqui no hay SPA que enrutar, y un 404 debe ser un 404 y
    # no la landing con HTTP 200.
    handle /okos-mapa* {
        root * /usr/share/caddy/landing
        file_server
    }

    # Root → landing page
    handle {
        root * /usr/share/caddy/landing
        try_files {path} index.html
        file_server
    }
}

:8080 {
    import rutas_principales
}

# --- Puerto 8091: HTTPS con Caddy terminando la TLS, para que el 443 publico de Tailscale
# Funnel deje de pasar por el terminador TLS de tailscaled (gVisor) y pase raw TCP hasta aca.
#
# POR QUE EXISTE (medido el 2026-09-27, hallazgo "El Funnel publico agrega 700ms-1,3s de TLS
# por un bug conocido de tailscaled, ademas del salto geografico a NYC"). El modo anterior
# (`tailscale funnel --https=443 http://localhost:8080`) hace que tailscaled TERMINE la TLS
# el mismo, con su stack de red en espacio de usuario (gVisor) — ahi Nagle esta prendido y sin
# `TCP_NODELAY`, y el issue publico tailscale/tailscale#18916 documenta exactamente este patron:
# el ServerHello sale en un paquete chico y el resto del vuelo (certificado+finished) en otro,
# y el ACK retrasado del cliente (200ms) mas Nagle esperando ese ACK antes de mandar el segundo
# paquete generan ~220ms de pausa, DOS VECES por handshake. Terminar la TLS en Caddy (socket real
# de Linux, no gVisor) saca esa pausa de la ecuacion — el salto geografico del Funnel hacia la
# region de ingreso mas cercana (NYC) sigue estando, pero deja de sumarse el bug.
#
# El certificado NO se genera aca: lo emite y renueva `tailscale cert` (mismo mecanismo que usa
# tailscaled para el modo HTTPS de siempre), un guion aparte lo escribe en el host
# (`vps-guardias/renovar-cert-funnel.sh`) y este bloque solo lo lee, montado de solo lectura.
:8091 {
    tls /etc/caddy/certs/funnel.crt /etc/caddy/certs/funnel.key
    import rutas_principales
}
